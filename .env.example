# Copy to .env (never commit .env). Every variable is optional.

# Where data, model runs and results live (defaults: ./data, ./runs, ./results)
# SAILAB_DATA_DIR=E:/sailab-data          # the 1-2 TB external drive
# SAILAB_RUNS_DIR=E:/sailab-data/runs

# PostGIS for the API (default: SQLite file in the data directory)
# SAILAB_DATABASE_URL=postgresql+psycopg://sailab:sailab@localhost:5432/sailab
# POSTGRES_PASSWORD=change-me

# Which datacube the API serves by default
SAILAB_CUBE=demo

# Dashboard -> API (Next.js rewrites)
SAILAB_API_URL=http://127.0.0.1:8000

# VIIRS flood archive (see src/sailab/sources/viirs.py)
# SAILAB_VIIRS_URL=ftp://jpssflood.gmu.edu/...
# SAILAB_VIIRS_MATCH=

# Credentials are NOT set here. Use each tool's own file:
#   EWDS / GloFAS:   ~/.cdsapirc   (url + key)
#   NASA Earthdata:  ~/.netrc      (machine urs.earthdata.nasa.gov login ... password ...)
#   Earth Engine:    `earthengine authenticate` (one shared noncommercial project)
